"""
Aimlock demo - CHỈ DÙNG CHO MỤC ĐÍCH HỌC TẬP
Yêu cầu: pip install opencv-python numpy mss ultralytics pynput
"""
import cv2
import numpy as np
import mss
import time
from ultralytics import YOLO

# Load model YOLOv8 (pretrained detect người)
model = YOLO("yolov8n.pt")

# Vùng màn hình giữa (FOV box)
FOV_SIZE = 400          # kích thước vùng quét
SCREEN_W, SCREEN_H = 1920, 1080
CENTER_X, CENTER_Y = SCREEN_W // 2, SCREEN_H // 2

sct = mss.mss()
monitor = {
    "left":   CENTER_X - FOV_SIZE // 2,
    "top":    CENTER_Y - FOV_SIZE // 2,
    "width":  FOV_SIZE,
    "height": FOV_SIZE,
}

print("[+] Aimlock demo chạy... Nhấn Ctrl+C để thoát.")

try:
    while True:
        # Chụp vùng FOV
        img = np.array(sct.grab(monitor))[:, :, :3]

        # Detect
        results = model(img, verbose=False, conf=0.5)
        boxes = results[0].boxes

        target = None
        min_dist = 9999

        for box in boxes:
            cls = int(box.cls[0])
            if cls != 0:  # chỉ lấy class "person"
                continue
            x1, y1, x2, y2 = box.xyxy[0].tolist()
            # Tâm đối tượng
            tx = (x1 + x2) / 2
            ty = y1 + (y2 - y1) * 0.25  # aim vào đầu (25% trên)
            # Khoảng cách tới tâm FOV
            dist = np.hypot(tx - FOV_SIZE/2, ty - FOV_SIZE/2)
            if dist < min_dist:
                min_dist = dist
                target = (tx, ty)

        if target:
            # Vẽ debug
            cv2.circle(img, (int(target[0]), int(target[1])), 5, (0, 255, 0), -1)
            # Ở đây bạn sẽ gọi hàm di chuyển chuột (mouse.move) 
            # ví dụ: pynput.mouse.Controller().move(dx, dy)
            print(f"[Target] FOV offset: {target[0]-FOV_SIZE/2:.1f}, {target[1]-FOV_SIZE/2:.1f}")

        cv2.imshow("Aimlock FOV", img)
        if cv2.waitKey(1) & 0xFF == 27:  # ESC
            break

except KeyboardInterrupt:
    pass
finally:
    cv2.destroyAllWindows()
